# =============================================================================
# Workflow app – environment variables
# =============================================================================
# Copy this file to .env and adjust for your environment.
# Defaults below point to *.carteracredit.workers.dev (dev Workers).
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment environment
# -----------------------------------------------------------------------------
# Controls which environment the "Publish" action targets. Must be one of
# "development" (default, creates/updates the workflow-<slug>-dev repo) or
# "production" (creates/updates the workflow-<slug> repo with -prod bindings
# and custom domain routes). Any other value is treated as "development".
# NOTE: name intentionally preserves the historical misspelling already in
# use across deployed environments; NEXT_PUBLIC_ENVIRONMENT (correct spelling)
# is also accepted as a fallback.
NEXT_PUBLIC_ENVIROMENT=development

# -----------------------------------------------------------------------------
# Workflow service (workflow-svc)
# -----------------------------------------------------------------------------
# Base URL for the workflow backend API (workflows, flags, deployments, etc.).
# Used by: workflow-api (config.ts), middleware does not use this.
NEXT_PUBLIC_WORKFLOW_SERVICE_URL=https://workflow-svc.carteracredit.workers.dev

# -----------------------------------------------------------------------------
# Auth service (auth-svc)
# -----------------------------------------------------------------------------
# Base URL for the auth backend API (get-session, token, jwks).
# Used by: middleware (session validation), auth config, getJwt, authClient.
NEXT_PUBLIC_AUTH_SERVICE_URL=https://auth-svc.carteracredit.workers.dev

# -----------------------------------------------------------------------------
# Auth app (auth frontend)
# -----------------------------------------------------------------------------
# Base URL for the auth frontend (login, signup). Users are redirected here
# when unauthenticated or when obtaining a JWT.
# Used by: middleware (redirect to login), auth config, getJwt (Origin header).
NEXT_PUBLIC_AUTH_APP_URL=https://auth.carteracredit.workers.dev

# -----------------------------------------------------------------------------
# Cases service (cases-svc)
# -----------------------------------------------------------------------------
# Base URL for the cases backend API (signatures/templates, etc.).
# Used by: workflow-api/signatures-actions (server actions).
NEXT_PUBLIC_CASES_SERVICE_URL=https://cases-svc.carteracredit.workers.dev

# -----------------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------------
# Client/runtime: DSN from the Sentry project (Events).
NEXT_PUBLIC_SENTRY_DSN=

# Build-time (source map upload via @sentry/webpack-plugin): set in CI / build env.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
